# Normalize all text files to LF line endings
* text=auto eol=lf

#= Linguist
docs/ linguist-documentation=true
tmtroot/ linguist-documentation=true
*.md linguist-language=Markdown
*.tmt linguist-language=Tomet

# `.md` under docs/spec/ and docs/guide/ is exported from the sibling
# `.tmt` source via `@config(export:)`, so it is generated, not authored.
# Scoped by path on purpose: the `.md` under docs/design/ is hand-written
# and must stay a normal, reviewable file.
#
# Matches nothing today -- no `.tmt` under either path declares
# `@config(export:)` yet. Kept because the rule has to exist before the
# first export lands, not after it. See `docs/.writ.tmt`'s
# `generated-md-not-edited`.
docs/spec/**/*.md linguist-generated=true
docs/guide/**/*.md linguist-generated=true

# Exported from `tmtroot/`, whose layout mirrors the repository root.
# `README.md` is not here: it is hand-written English, and only its
# Japanese sibling is generated.
/AGENTS.md linguist-generated=true
/README.ja.md linguist-generated=true

# Frozen parser/formatter test inputs, deliberately not synced with docs/.
tests/fixtures/ linguist-vendored=true

# Written by `tree-sitter generate` from `grammar.js` (see `just gen-treesitter`).
# They are committed because the editors build the grammar straight from this
# repository, and marked generated so a regeneration -- tens of thousands of
# changed lines, whatever the edit -- is collapsed in review and left out of the
# language statistics.
crates/tree-sitter-tomet/src/parser.c linguist-generated=true
crates/tree-sitter-tomet/src/grammar.json linguist-generated=true
crates/tree-sitter-tomet/src/node-types.json linguist-generated=true

#= Git LFS
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.ico filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
