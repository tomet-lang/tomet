@kind(vocabulary)
@vocabulary(dirs){ version: "1.0.0" }

@element(dirs){
  display: block
  @args{
    @param(path){ type: string, positional: true, required: true }[ ディレクトリのパス。 ]
  }
}[
  ディレクトリひとつ。`[content]` が説明。
]

@element(file){
  display: block
  @args{
    @param(path){ type: string, positional: true, required: true }[ ファイルのパス。 ]
  }
}[
  ファイルひとつ。`[content]` が説明。
  `std` の `@link(target:"file:...")` とは別物で、こちらは
  リンクではなくツリーの一項目を表す。
]
