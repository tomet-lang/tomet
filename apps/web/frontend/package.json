{
  "name": "tomet-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Svelte 5 + CodeMirror 6 interactive web playground powered by @tomet/svelte",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:local": "vite build && cp -r dist/* ../static/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.7.0",
    "@codemirror/language": "^6.10.0",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.4.0",
    "@codemirror/view": "^6.34.0",
    "@lezer/highlight": "^1.2.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
