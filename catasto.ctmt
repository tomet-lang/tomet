::upstreams(
  commonfiles:  (git: "https://github.com/tomet-lang/commonfiles.git", rev: main, root: base)
  vocabularies: (git: "https://github.com/tomet-lang/vocabularies.git", rev: main, root: vocabularies)
)

// --- Vocabularies ---
"tmtroot/schema/vocabularies/writ@1.0.0.vocabulary.tmt": (source: (upstream: vocabularies, path: "writ/writ@1.0.0.vocabulary.tmt"))
"tmtroot/schema/vocabularies/rust@1.0.0.vocabulary.tmt": (source: (upstream: vocabularies, path: "rust/rust@1.0.0.vocabulary.tmt"))
// --- Environment ---
".editorconfig":  (source: (upstream: commonfiles, path: ".editorconfig"))
".envrc":         (source: (upstream: commonfiles, path: ".envrc"))
"LICENSE-APACHE": (source: (upstream: commonfiles, path: "LICENSE-APACHE"))
"LICENSE-MIT":    (source: (upstream: commonfiles, path: "LICENSE-MIT"))
// --- vendor config ---
".github/workflows/nix-ci.yml": (source: (upstream: commonfiles, path: ".github/workflows/nix-ci.yml"))
".github/workflows/pages.yml":  (source: (upstream: commonfiles, path: ".github/workflows/pages.yml"))
"nix/formatter.nix":            (source: (upstream: commonfiles, path: "nix/formatter.nix"))
// The editor extensions are published on their own, so each carries the licenses.
"editors/vscode/LICENSE-APACHE": (source: (upstream: commonfiles, path: "LICENSE-APACHE"))
"editors/vscode/LICENSE-MIT":    (source: (upstream: commonfiles, path: "LICENSE-MIT"))
"editors/zed/LICENSE-APACHE":    (source: (upstream: commonfiles, path: "LICENSE-APACHE"))
"editors/zed/LICENSE-MIT":       (source: (upstream: commonfiles, path: "LICENSE-MIT"))
