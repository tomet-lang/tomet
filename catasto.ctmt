// The files catasto manages in this workspace. Each key is a path here;
// `source` is where its canonical content comes from.
::upstreams{
  commonfiles: { git: "https://github.com/tomet-lang/commonfiles.git", rev: main, root: base }
}

// Environment
".editorconfig": {
  source: { upstream: commonfiles, path: ".editorconfig" }
}
".envrc": {
  source: { upstream: commonfiles, path: ".envrc" }
}
".github/workflows/nix-ci.yml": {
  source: { upstream: commonfiles, path: ".github/workflows/nix-ci.yml" }
}
".github/workflows/pages.yml": {
  source: { upstream: commonfiles, path: ".github/workflows/pages.yml" }
}
"nix/formatter.nix": {
  source: { upstream: commonfiles, path: "nix/formatter.nix" }
}
"LICENSE-APACHE": {
  source: { upstream: commonfiles, path: "LICENSE-APACHE" }
}
"LICENSE-MIT": {
  source: { upstream: commonfiles, path: "LICENSE-MIT" }
}

// The editor extensions are published on their own, so each carries the licenses.
"editors/vscode/LICENSE-APACHE": {
  source: { upstream: commonfiles, path: "LICENSE-APACHE" }
}
"editors/vscode/LICENSE-MIT": {
  source: { upstream: commonfiles, path: "LICENSE-MIT" }
}
"editors/zed/LICENSE-APACHE": {
  source: { upstream: commonfiles, path: "LICENSE-APACHE" }
}
"editors/zed/LICENSE-MIT": {
  source: { upstream: commonfiles, path: "LICENSE-MIT" }
}
