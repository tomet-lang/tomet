::kind(writ)

@rule(tomet-sort-purity){
  why: | `tomet-sort` is a pure, side-effect-free base-layer crate providing character and
       | dictionary collation, sort keys, and ordering primitives. It performs no I/O and
       | holds zero external dependencies, and it depends on no other workspace crate.
       | Which crates may depend on it is the root `.writ.tmt`'s.
  guard: { twrit: pure }
  pure: {
    crates: [ "crates/tomet-base-sort" ]
    forbid: [ "std::fs", "std::net", "std::process", "std::env" ]
    allow-external: []
  }
}
