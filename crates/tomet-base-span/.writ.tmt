::kind(writ)
::use(rust)

@rule(tomet-span-dependencies){
  why: | `tomet-span` is a base-layer crate representing byte ranges and offsets.
       | It holds zero dependencies on other workspace members.
  guard: { twrit: dependencies }
  crate: @crate(tomet-span)
  dependencies: list()
}

@rule(tomet-span-purity){
  why: | `tomet-span` is pure and side-effect-free.
       | It performs no I/O, and depends externally only on `serde` (and its derive closure).
  guard: { twrit: pure }
  crate: @crate(tomet-span)
  pure: {
    forbid: list("std::fs", "std::net", "std::process", "std::env")
    allow-external: list(
      "serde", "serde_core", "serde_derive",
      "proc-macro2", "quote", "syn", "unicode-ident"
    )
  }
}
