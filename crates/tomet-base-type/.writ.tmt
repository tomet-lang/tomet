::kind(writ)

@rule(tomet-type-purity){
  why: | `tomet-type` is a pure, side-effect-free base-layer crate representing the type
       | vocabulary. It performs no I/O and holds no external dependency of its own, and the
       | one workspace crate it depends on is `tomet-scalar`, the scalar a type's values are
       | made of. Which crates may depend on it is the root `.writ.tmt`'s.
  guard: ( twrit: pure )
  pure: (
    crates: [ "crates/tomet-base-type" ]
    forbid: [ "std::fs", "std::net", "std::process", "std::env" ]
    allow-external: []
  )
}
