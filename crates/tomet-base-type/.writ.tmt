::kind(writ)

@rule(tomet-type-purity){
  why: | `tomet-type` is a pure, side-effect-free base-layer crate representing the type
       | vocabulary. It performs no I/O and holds no external dependency of its own, and the
       | one workspace crate it depends on is `tomet-scalar`, the scalar a type's values are
       | made of. What it reaches externally comes through `tomet-scalar`: `serde` (and its
       | derive closure), plus `schemars` (and its closure) behind the `schema` feature.
       | Which crates may depend on it is the root `.writ.tmt`'s.
  guard: ( twrit: pure )
  pure: (
    crates: [ "crates/tomet-base-type" ]
    forbid: [ "std::fs", "std::net", "std::process", "std::env" ]
    allow-external: [
      // Through `tomet-scalar`.
      "serde", "serde_core", "serde_derive",
      "proc-macro2", "quote", "syn", "unicode-ident",
      // The `schema` feature: JSON Schema of the AST wire, never in wasm.
      "schemars", "schemars_derive", "serde_derive_internals", "dyn-clone",
      "ref-cast", "ref-cast-impl", "serde_json", "itoa", "memchr", "zmij",
      "indexmap", "equivalent", "hashbrown"
    ]
  )
}
