        },
        {
          "type": "STRING",
          "value": "["
        },
        {
          "type": "FIELD",
          "name": "content",
          "content": {
            "type": "REPEAT",
            "content": {
              "type": "SYMBOL",
              "name": "_bracket_item"
            }
          }
        },
        {
          "type": "STRING",
          "value": "]"
        },
        {
          "type": "FIELD",
          "name": "close",
          "content": {
            "type": "ALIAS",
            "content": {
              "type": "SYMBOL",
              "name": "_dash_run"
            },
            "named": true,
            "value": "thematic_break_marker"
          }
        },
        {
          "type": "SYMBOL",
          "name": "_newline"
        }
      ]
    },
    "line_comment": {
      "type": "PATTERN",
      "value": "\\/\\/[^\\n]*"
    },
    "block_comment": {
      "type": "PATTERN",
      "value": "\\/\\*(?:[^*]|\\*+[^*/])*\\*+\\/"
    },
