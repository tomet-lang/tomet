@meta{ type: config }
@config(format:json){
  {
    "format": {
      "meta": {
        "always_newline": true,
        "format": "yaml"
      },
      "heading": {
        "space_inside_brackets": true
      },
      "table": {
        "adjust_width": "auto",
        "max_col_width": 20
      }
    }
  }
}
