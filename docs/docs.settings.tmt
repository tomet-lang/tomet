@kind(settings)
@settings(format:json)+++
{
  elements = {
    bookmark = {
      args = {
        name = { type = string },
        count = { type = uint, default = 0 },
        variant = { type = string }
      },
      required = [ name ],
      positional = [ name ],
      content = nest(allow = [callout, codeblock]),
      placement = block,
      singleton = false
    }
  },
  types = {
    bookmark = {
      style = one_line
    },
    todo = {}
  }
}
+++
