@settings(file:docs/docs.settings.tmt)
@meta{}

```tm
@kind(@string)
@version(@string)

@meta(format:json)
@config(format:json)

@link(https:@url)[ display_name ]
@link(file:@file)[ display_name ]
@link(tmt:@tmt_file)[ display_name ]
@link(ref:@ref)

@heading(level: @int)[ display_name ]

@references[
  @id(asdf-asdf):()
  @id(asdf-asdf):[]
  @id(asdf-asd2):{tag: important}
  @id(asdf-asdf):(){}[]
]

@embed(file:@file)[alt]
@codeblock(lang:@language)[ @code ]
@blockquote[ @content ]

${func(args) ...}
$func(args)
$(@var)

- (marker:@string) content
-. (marker:@string) content

// comment
/* comments */
```

