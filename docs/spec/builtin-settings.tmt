@kind(settings)

/* Tomet 設定DSL (Config DSL / Schema Specification)
   詳細な文法・スキーマ型定義の仕様は docs/design/decisions/2026-08-20-dsl-specifications.md を参照。

   要素スキーマ定義の特徴:
   - 必須フィールド一括指定: `required: [title, id]` (JSON Schema / OpenAPI 標準に準拠)
   - 位置引数指定: `positional: [title]`
   - 埋め込みフォーマット: `#settings(format: json)` または `#settings(format: yaml)` の併用サポート */

@settings{
  // 実際に Sigil を持つ「要素」(tomet_semantics::ElementKind)の一覧。
  // 名前で識別できるものだけがここに乗る -- @T/@name で誰でも増やせる。
  elements: {
    kind: {
      // 文書の種別。この文書を検証するスキーマを選ぶ。
      // 値は文字列で、`j.daily` のような名前空間つきも単なる文字列。
      // 効くのは先頭のトップレベル `@kind` 一つだけ (tomet_semantics::document_kind)。
      // 未実装: placement/singleton はまだ強制されない。`tomet check` は
      // パースしかせず、singleton の実装はどこにも無い。
      args: { kind: { type: string } },
      required: [ kind ],
      positional: [ kind ],
      placement: head,
      singleton: true
    },
    version: {
      // 構文バージョン。ワークスペース直下の設定文書に一度書けば全体に効くので、
      // 個々の文書には書かない。
      // 値は文字列・整数・小数のいずれでもよく (`@version(1.0)` は小数)、
      // 読み出し時に文字列へ正規化される。
      // 未実装: placement/singleton は kind と同じくまだ強制されない。
      args: { version: { type: string } },
      required: [ version ],
      positional: [ version ],
      placement: head,
      singleton: true
    },
    settings: {
      args: { target: { type: string } },
      required: [ target ],
      values: any,
      placement: head,
      singleton: true
    },
    config: {
      // args reads format, style, and export ({ type, path }).
      args: {
        format: [ json, toml, yaml ],
        export: {
          type: [ commonmark, html ],
          path: string
        }
      },
      placement: head,
      singleton: true
    },
    meta: {
      // meta の {value} は現状どのconsumerからも読まれない
      // (html/markdownどちらも素通りする)。id はここでは将来案。
      // `type` はここには無い。文書の種別は `@kind` が持つ。
      args: { format: [ json, toml, yaml ] },
      values: { id: uuid },
      placement: head,
      singleton: true
    },
    // `@link` という明示名には特別な意味は無い。実際に特別レンダリング
    // されるのは url/file/ref (と、名前省略時の @(url:...) 等のキー推論)。
    url: {
      args: { target: { type: string } },
      required: [ target ],
      content: inline,
      placement: inline
    },
    file: {
      args: { target: { type: string } },
      required: [ target ],
      content: inline,
      placement: inline
    },
    ref: {
      args: { target: { type: string } },
      required: [ target ],
      content: inline,
      placement: inline
    },
    embed: {
      // src には file/url のみ使われる(refでは解決されない)
      args: { target: { type: string } },
      required: [ target ],
      content: inline,
      placement: inline
    },
    hr: {
      content: inline,
      placement: block
    },
    em: {
      content: inline,
      placement: inline
    },
    strong: {
      content: inline,
      placement: inline
    },
    mark: {
      content: inline,
      placement: inline
    },
    codeblock: {
      args: { lang: { type: string } },
      content: raw,
      placement: block
    },
    blockquote: {
      content: raw,
      placement: block
    }
  },

  // 見出し/リスト/インラインコードのような構文プリミティブは Sigil を
  // 持たず classify() の対象にもならない -- @T/@name のように誰でも
  // 追加できる「要素」ではないので、elements とは別枠にした。
  primitives: {
    heading: {
      placement: block,
      content: inline
    },
    list: {
      placement: block
    },
    list_ordered: {
      placement: block
    },
    thematic_break: {      // 3つ以上の '-'。実体は elements.hr と同じ
      placement: block
    },
    fenced_code: {         // 3つの backtick。実体は elements.codeblock と同じ
      args: { lang: { type: string } },
      placement: block,
      content: language
    },
    inline_code_span: {    // 1つの backtick。地の文保護のみで@codeにはならない
      placement: inline,
      content: raw
    }
  }
}
