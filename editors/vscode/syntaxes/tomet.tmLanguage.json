{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Tomet",
	"scopeName": "source.tomet",
	"fileTypes": ["tm", "tmt"],
	"patterns": [
		{ "include": "#comments" },
		{ "include": "#fenced-code-block" },
		{ "include": "#raw-fence" },
		{ "include": "#heading" },
		{ "include": "#thematic-break" },
		{ "include": "#list-marker" },
		{ "include": "#marked-content" },
		{ "include": "#inline" }
	],
	"repository": {
		"comments": {
			"comment": "A comment opens only at the start of a line or after whitespace. `https://example.com` keeps its slashes -- same boundary the parser uses (`eat_scalar_raw` in tomet-syntax-parser/src/value.rs, `is_line_comment_start` in document.rs). Without the lookbehind a bare URL inside `(...)` ate the closing paren and every line after it.",
			"patterns": [
				{
					"name": "comment.line.double-slash.tomet",
					"match": "(?<![^ \\t])//.*$"
				},
				{
					"name": "comment.block.tomet",
					"begin": "(?<![^ \\t])/\\*",
					"end": "\\*/"
				}
			]
		},

		"autolink": {
			"comment": "A bare URL is an autolink -- the parser rewrites `see https://example.com` into a `@link` element. Listed before `#map-entry` so the scheme's `:` is not read as a key separator.",
			"match": "(?<![A-Za-z0-9_])[A-Za-z][A-Za-z0-9+.-]*://[^\\s,()\\[\\]{}\"]+",
			"name": "markup.underline.link.tomet string.other.link.tomet"
		},

		"fenced-code-block": {
			"begin": "^\\s*(```)(?:([a-zA-Z0-9_+-]+))?\\s*$",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.markdown keyword.control.fence.tomet" },
				"2": { "name": "fenced_code.block.language.tomet entity.name.type.fence.tomet" }
			},
			"end": "^\\s*(```)\\s*$",
			"endCaptures": {
				"0": { "name": "punctuation.definition.markdown keyword.control.fence.tomet" }
			},
			"name": "markup.raw.block.fenced.tomet"
		},

		"heading": {
			"comment": "`#` is the heading marker and nothing else -- it stopped being a block-element sigil when the shape axis was retracted. The run's length is the level. Three spellings: `#[ ... ]`, `#(args)[ ... ]`, and the bracket-less `# text` sugar.",
			"patterns": [
				{
					"comment": "`##(id: sec)[ 見出し ]` -- a heading takes `(args)` and a trailing `{value}` like any element.",
					"begin": "^[ \\t]*(#+)(?=[ \\t]*\\()",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.heading.tomet" }
					},
					"end": "(?<=\\])",
					"name": "markup.heading.tomet",
					"patterns": [
						{ "include": "#round-group" },
						{ "include": "#square-group" }
					]
				},
				{
					"begin": "^[ \\t]*(#+)[ \\t]*(\\[)",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.heading.tomet" },
						"2": { "name": "punctuation.section.brackets.begin.tomet" }
					},
					"end": "\\]",
					"endCaptures": {
						"0": { "name": "punctuation.section.brackets.end.tomet" }
					},
					"name": "markup.heading.tomet",
					"patterns": [{ "include": "#inline" }]
				},
				{
					"begin": "^[ \\t]*(#+)[ \\t]*(\\|)",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.heading.tomet" },
						"2": { "name": "punctuation.definition.pipe.tomet keyword.control.pipe.tomet" }
					},
					"end": "$",
					"name": "markup.heading.tomet",
					"patterns": [{ "include": "#inline" }]
				},
				{
					"comment": "Bracket-less sugar. Requires the space: `#name` with no space is not a heading, and no longer an element either -- it falls back to prose, which is what keeps `#タグ` and a shell comment inside a fence as text.",
					"begin": "^[ \\t]*(#+)(?=[ \\t]+\\S)",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.heading.tomet" }
					},
					"end": "$",
					"name": "markup.heading.tomet",
					"patterns": [{ "include": "#inline" }]
				}
			]
		},

		"thematic-break": {
			"patterns": [
				{
					"begin": "^\\s*(-{3,})\\s*(\\[)",
					"beginCaptures": {
						"1": { "name": "punctuation.definition.thematic-break.tomet keyword.control.thematic-break.tomet" },
						"2": { "name": "punctuation.section.brackets.begin.tomet" }
					},
					"end": "(\\])\\s*(-{3,})\\s*$",
					"endCaptures": {
						"1": { "name": "punctuation.section.brackets.end.tomet" },
						"2": { "name": "punctuation.definition.thematic-break.tomet keyword.control.thematic-break.tomet" }
					},
					"name": "markup.heading.thematic-break.tomet",
					"patterns": [{ "include": "#inline" }]
				},
				{
					"match": "^\\s*-{3,}\\s*$",
					"name": "punctuation.definition.thematic-break.tomet keyword.control.thematic-break.tomet"
				}
			]
		},

		"list-marker": {
			"patterns": [
				{
					"match": "^\\s*(-\\.|-)(?=[ \\t\\[|(])(?:\\s*(\\()([^()\\n]*)(\\)))?",
					"captures": {
						"1": { "name": "punctuation.definition.list.begin.markdown markup.list.tomet keyword.control.list.tomet" },
						"2": { "name": "punctuation.definition.marker.begin.tomet" },
						"3": { "name": "keyword.operator.marker.tomet markup.list.marker.tomet" },
						"4": { "name": "punctuation.definition.marker.end.tomet" }
					}
				}
			]
		},

		"marked-content": {
			"comment": "`|` opens a content group and closes at the end of its run. It goes where `[` can go (after an element or list item, or as table rows).",
			"match": "\\|",
			"name": "punctuation.definition.pipe.tomet keyword.control.pipe.tomet"
		},

		"inline": {
			"comment": "No `#string` here on purpose: a quote is only a string delimiter inside a `(args)`/`{value}` group, where `#value` supplies it. In prose `\"` is an ordinary character, so including it here turned `これは 5\" のディスク` into a string that ran to the end of the file.",
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#code-span" },
				{ "include": "#autolink" },
				{ "include": "#strong" },
				{ "include": "#emphasis" },
				{ "include": "#mark" },
				{ "include": "#interpolation" },
				{ "include": "#connect" },
				{ "include": "#element" },
				{ "include": "#marked-content" },
				{ "include": "#groups" }
			]
		},

		"inline-basic": {
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#code-span" },
				{ "include": "#autolink" },
				{ "include": "#interpolation" },
				{ "include": "#connect" },
				{ "include": "#element" },
				{ "include": "#groups" }
			]
		},

		"code-span": {
			"name": "markup.inline.raw.tomet",
			"match": "`[^`\\n]*`"
		},

		"strong": {
			"comment": "`try_one_delimited` (tomet-syntax-parser/src/inline.rs) is the model for all three delimiter rules: an `_` run does not open when the character before it is alphanumeric -- that is what keeps `serde_tomet` and `from_str` out of italics -- the closing run may not have whitespace before it, and the search gives up at a blank line. Without that last bound one stray `_` ran to the end of the file and stripped every heading, list and element below it of its scope.",
			"patterns": [
				{
					"begin": "\\*\\*(?=\\S)",
					"end": "(?<=\\S)\\*\\*|^(?=[ \\t]*$)",
					"name": "markup.bold.tomet",
					"patterns": [{ "include": "#inline-basic" }]
				},
				{
					"begin": "(?<![[:alnum:]])__(?=\\S)",
					"end": "(?<=\\S)__|^(?=[ \\t]*$)",
					"name": "markup.bold.tomet",
					"patterns": [{ "include": "#inline-basic" }]
				}
			]
		},

		"emphasis": {
			"patterns": [
				{
					"begin": "\\*(?=\\S)",
					"end": "(?<=\\S)\\*|^(?=[ \\t]*$)",
					"name": "markup.italic.tomet",
					"patterns": [{ "include": "#inline-basic" }]
				},
				{
					"begin": "(?<![[:alnum:]])_(?=\\S)",
					"end": "(?<=\\S)_|^(?=[ \\t]*$)",
					"name": "markup.italic.tomet",
					"patterns": [{ "include": "#inline-basic" }]
				}
			]
		},

		"mark": {
			"comment": "`==x==` is a highlight, not a deletion. It used to carry `markup.strikethrough`, which every theme renders as struck-through text.",
			"begin": "==(?=\\S)",
			"end": "==|^(?=[ \\t]*$)",
			"name": "markup.highlight.tomet markup.inserted.tomet",
			"patterns": [{ "include": "#inline-basic" }]
		},

		"connect": {
			"match": "(<->|->|<-|==>|--)",
			"name": "keyword.operator.connect.tomet"
		},

		"interpolation": {
			"patterns": [
				{
					"begin": "\\$\\{",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.template-expression.begin.tomet" }
					},
					"end": "\\}",
					"endCaptures": {
						"0": { "name": "punctuation.definition.template-expression.end.tomet" }
					},
					"name": "meta.template.expression.tomet",
					"patterns": [
						{ "include": "#comments" },
						{ "include": "#string" },
						{
							"match": "\\b[0-9]+(\\.[0-9]+)?\\b",
							"name": "constant.numeric.tomet"
						},
						{
							"match": "([A-Za-z_][A-Za-z0-9_.-]*)\\s*(?=\\()",
							"captures": {
								"1": { "name": "entity.name.function.tomet" }
							}
						},
						{
							"match": "\\b[A-Za-z_][A-Za-z0-9_.-]*\\b",
							"name": "variable.other.readwrite.tomet"
						},
						{
							"match": "[,()]",
							"name": "punctuation.separator.tomet"
						}
					]
				},
				{
					"begin": "(\\$)([A-Za-z_][A-Za-z0-9_.-]*)\\s*(\\()",
					"beginCaptures": {
						"1": { "name": "entity.name.function.sigil.tomet entity.name.function.tomet" },
						"2": { "name": "entity.name.function.tomet" },
						"3": { "name": "punctuation.definition.parameters.begin.tomet entity.name.function.tomet" }
					},
					"end": "\\)",
					"endCaptures": {
						"0": { "name": "punctuation.definition.parameters.end.tomet entity.name.function.tomet" }
					},
					"name": "meta.template.expression.tomet",
					"patterns": [
						{ "include": "#comments" },
						{ "include": "#string" },
						{
							"match": "\\b[0-9]+(\\.[0-9]+)?\\b",
							"name": "constant.numeric.tomet"
						},
						{
							"match": "([A-Za-z_][A-Za-z0-9_.-]*)\\s*(?=\\()",
							"captures": {
								"1": { "name": "entity.name.function.tomet" }
							}
						},
						{
							"match": "\\b[A-Za-z_][A-Za-z0-9_.-]*\\b",
							"name": "variable.other.readwrite.tomet"
						},
						{
							"match": ",",
							"name": "punctuation.separator.tomet"
						}
					]
				}
			]
		},

		"element": {
			"comment": "`@name` is the only element sigil, whatever the element's placement: `#` is the heading marker and nothing else, and shape comes from position rather than spelling. The name is required -- a name-less `@(...)` stopped forming an element. Names are ASCII, `.`-separated for namespaces (`@deck.ref`). Both alternatives refuse a `@` preceded by a word character, which is the half that keeps an email address prose.",
			"patterns": [
				{
					"comment": "Element with attached groups: @name(...) / @name[...] / @name{...}. Captures brackets with tag scope so the element shell is unified.",
					"begin": "(?<![A-Za-z0-9_])(@)([A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*)(?=[ \\t]*[(\\[{])",
					"beginCaptures": {
						"1": { "name": "entity.name.tag.sigil.tomet entity.name.tag.tomet" },
						"2": { "name": "entity.name.tag.tomet" }
					},
					"end": "(?<=\\]|\\)|\\})(?![ \\t]*[(\\[{])|^(?=[ \\t]*$)",
					"patterns": [
						{ "include": "#element-round-group" },
						{ "include": "#element-square-group" },
						{ "include": "#element-curly-group" }
					]
				},
				{
					"comment": "Mid-line: an element needs one of `( [ { :` or a `+++` fence after the name. Without one it is text -- `連絡は me@example.com まで` is a paragraph. The whitespace in the lookahead is what spec/syntax.tmt's `@name () [] {}` spelling needs; the group does not have to be flush against the name.",
					"match": "(?<![A-Za-z0-9_])(@)([A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*)(?=[ \\t]*(?:[(\\[{:|]|\\+{3,}))",
					"captures": {
						"1": { "name": "entity.name.tag.sigil.tomet entity.name.tag.tomet" },
						"2": { "name": "entity.name.tag.tomet" }
					}
				},
				{
					"comment": "A bare `@name` that starts and ends its own line. This is where the block rule's end-of-line allowance lands; the real parser also requires block context, which a line-oriented grammar cannot see.",
					"match": "^[ \\t]*(@)([A-Za-z_][A-Za-z0-9_-]*(?:\\.[A-Za-z_][A-Za-z0-9_-]*)*)[ \\t]*$",
					"captures": {
						"1": { "name": "entity.name.tag.sigil.tomet entity.name.tag.tomet" },
						"2": { "name": "entity.name.tag.tomet" }
					}
				}
			]
		},

		"element-round-group": {
			"begin": "\\(",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.tag.bracket.round.begin.tomet punctuation.section.group.round.begin.tomet entity.name.tag.bracket.tomet entity.name.tag.tomet" }
			},
			"end": "\\)",
			"endCaptures": {
				"0": { "name": "punctuation.definition.tag.bracket.round.end.tomet punctuation.section.group.round.end.tomet entity.name.tag.bracket.tomet entity.name.tag.tomet" }
			},
			"name": "meta.group.round.tomet",
			"patterns": [{ "include": "#value" }]
		},

		"element-square-group": {
			"begin": "\\[",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.tag.bracket.square.begin.tomet punctuation.section.group.square.begin.tomet entity.name.tag.bracket.tomet entity.name.tag.tomet" }
			},
			"end": "\\]",
			"endCaptures": {
				"0": { "name": "punctuation.definition.tag.bracket.square.end.tomet punctuation.section.group.square.end.tomet entity.name.tag.bracket.tomet entity.name.tag.tomet" }
			},
			"name": "meta.group.square.tomet",
			"patterns": [{ "include": "#inline" }]
		},

		"element-curly-group": {
			"begin": "\\{",
			"beginCaptures": {
				"0": { "name": "punctuation.definition.tag.bracket.curly.begin.tomet punctuation.section.group.curly.begin.tomet entity.name.tag.bracket.tomet entity.name.tag.tomet" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "punctuation.definition.tag.bracket.curly.end.tomet punctuation.section.group.curly.end.tomet entity.name.tag.bracket.tomet entity.name.tag.tomet" }
			},
			"name": "meta.group.curly.tomet",
			"patterns": [{ "include": "#value" }, { "include": "#element" }]
		},

		"raw-fence": {
			"comment": "A `+++` fence carries a raw or embedded body: `@memo+++`, `@meta(format:yaml)+++`. It opens at the end of an element head and closes on a line holding only the run. A longer run escapes a body containing `+++`, matching the backtick fence's rule. The lookbehind is what keeps this from firing on the closing line: an opener always follows a name or a group's closing bracket.",
			"begin": "(?<=[)\\]}A-Za-z0-9_-])(\\+{3,})[ \\t]*$",
			"beginCaptures": {
				"1": { "name": "punctuation.definition.raw.begin.tomet keyword.control.raw.tomet" }
			},
			"end": "^[ \\t]*(\\+{3,})[ \\t]*$",
			"endCaptures": {
				"1": { "name": "punctuation.definition.raw.end.tomet keyword.control.raw.tomet" }
			},
			"name": "markup.raw.block.fence.tomet"
		},

		"groups": {
			"comment": "Square brackets are the one group whose meaning depends on where it was entered from: `[content]` after an element is prose, `[a, b]` inside a `(args)`/`{value}` is a sequence. `#groups` is the content reading and `#value-groups` the value one; `(...)` and `{...}` are values either way.",
			"patterns": [
				{ "include": "#round-group" },
				{ "include": "#square-group" },
				{ "include": "#curly-group" }
			]
		},

		"value-groups": {
			"patterns": [
				{ "include": "#round-group" },
				{ "include": "#square-seq" },
				{ "include": "#curly-group" }
			]
		},

		"square-seq": {
			"begin": "\\[",
			"beginCaptures": {
				"0": { "name": "punctuation.section.group.square.begin.tomet" }
			},
			"end": "\\]",
			"endCaptures": {
				"0": { "name": "punctuation.section.group.square.end.tomet" }
			},
			"name": "meta.sequence.tomet",
			"patterns": [{ "include": "#value" }]
		},

		"round-group": {
			"begin": "\\(",
			"beginCaptures": {
				"0": { "name": "punctuation.section.group.round.begin.tomet" }
			},
			"end": "\\)",
			"endCaptures": {
				"0": { "name": "punctuation.section.group.round.end.tomet" }
			},
			"name": "meta.group.round.tomet",
			"patterns": [{ "include": "#value" }]
		},

		"square-group": {
			"begin": "\\[",
			"beginCaptures": {
				"0": { "name": "punctuation.section.group.square.begin.tomet" }
			},
			"end": "\\]",
			"endCaptures": {
				"0": { "name": "punctuation.section.group.square.end.tomet" }
			},
			"name": "meta.group.square.tomet",
			"patterns": [{ "include": "#inline" }]
		},

		"curly-group": {
			"begin": "\\{",
			"beginCaptures": {
				"0": { "name": "punctuation.section.group.curly.begin.tomet" }
			},
			"end": "\\}",
			"endCaptures": {
				"0": { "name": "punctuation.section.group.curly.end.tomet" }
			},
			"name": "meta.group.curly.tomet",
			"patterns": [{ "include": "#value" }, { "include": "#element" }]
		},

		"value": {
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#element" },
				{ "include": "#autolink" },
				{ "include": "#map-entry" },
				{ "include": "#string" },
				{ "include": "#interpolation" },
				{ "include": "#value-groups" },
				{ "include": "#scalar" }
			]
		},

		"map-entry": {
			"begin": "([A-Za-z_][A-Za-z0-9_.-]*)(:)",
			"beginCaptures": {
				"1": { "name": "variable.other.property.tomet" },
				"2": { "name": "punctuation.separator.key-value.tomet" }
			},
			"end": "(?=[,)\\]}]|$)",
			"patterns": [
				{ "include": "#comments" },
				{ "include": "#element" },
				{ "include": "#autolink" },
				{ "include": "#string" },
				{ "include": "#interpolation" },
				{ "include": "#value-groups" },
				{ "include": "#scalar" },
				{
					"match": "[^,()\\[\\]{}\\n\"\\s][^,()\\[\\]{}\\n\"]*",
					"name": "string.unquoted.plain.tomet"
				}
			]
		},

		"scalar": {
			"comment": "Unquoted values. `parse_scalar` tries i64, then f64, then falls back to a string, so the number rules go first. Positional arguments live here too -- `@kind(bookmark)`'s `bookmark` used to carry no scope at all and rendered in the plain foreground.",
			"patterns": [
				{
					"match": "(?<![A-Za-z0-9_.-])[+-]?[0-9]+(?:\\.[0-9]+)?(?![A-Za-z0-9_.-])",
					"name": "constant.numeric.tomet"
				},
				{
					"match": "(?<![A-Za-z0-9_.-])(?:true|false|null)(?![A-Za-z0-9_.-])",
					"name": "constant.language.tomet"
				},
				{
					"match": "[^\\s,()\\[\\]{}\"]+",
					"name": "string.unquoted.plain.tomet"
				}
			]
		},

		"string": {
			"comment": "The blank-line escape hatch is not in `parse_quoted` -- an unterminated quote is a hard parse error there. It is here so one stray `\"` cannot repaint the rest of the document.",
			"name": "string.quoted.double.tomet",
			"begin": "\"",
			"end": "\"|^(?=[ \\t]*$)",
			"patterns": [
				{ "match": "\\\\.", "name": "constant.character.escape.tomet" }
			]
		}
	}
}
