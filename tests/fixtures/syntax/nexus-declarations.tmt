// The declarations that used to take `{...}` alone take `(...)`:
// `::meta(...)`, not `::meta{...}`. `::blueprint(kind){ ... }` already had a
// `(...)` and keeps the `{...}` body after it. The parser reads declarations without knowing what they mean, so
// one document can carry all of them.

::kind(fixture)
::meta(title: "nexus declarations", tags: (a, b))
::macro(gh: "https://github.com/tomet/tomet/issues/$(1)")
::var(
  title: { type: string, default: "Daily" }
)
::format(table: { max_col_width: 50 })
::field(created: { type: datetime, format: rfc3339 })
::workspace(ignore: ("tests/fixtures"))
::export(type: commonmark, path: "README.md")
::blueprint(daily: "daily.blueprint.tmt")
::vocabulary(deck: "deck.vocabulary.tmt")
::dictionary(tomet: "tomet.dict.tmt")
::migration(meta: { created: { type: datetime, format: iso8601 } })
::element(
  card: { display: block }
)
::blueprint(daily){ version: "1.0" }

