// Migration 0001: the document-level declarations are written `::name`, and
// footnotes are `@ftn`.
//
//   tandr run -r tmtroot/migrations/0001-document-declarations.tandr -i .
//
// Only the head of each element changes (`@kind` becomes `::kind`); the
// arguments, data, content, id and connects stay byte for byte as they were.
// Run it while the old spellings still parse: once `^` and `@footnote` are
// refused, `tandr` no longer sees them. See tmtroot/dev/design/document-connects.tmt.

doc_kind:       { match: "@kind",       replace: { head: "::kind" } }
doc_version:    { match: "@version",    replace: { head: "::version" } }
doc_use:        { match: "@use",        replace: { head: "::use" } }
doc_config:     { match: "@config",     replace: { head: "::config" } }
doc_settings:   { match: "@settings",   replace: { head: "::settings" } }
doc_blueprint:  { match: "@blueprint",  replace: { head: "::blueprint" } }
doc_vocabulary: { match: "@vocabulary", replace: { head: "::vocabulary" } }
doc_meta:       { match: "@meta",       replace: { head: "::meta" } }

footnote_name:  { match: "@footnote",         replace: { head: "@ftn" } }
caret_plain:    { match: "^(?())",            replace: { head: "@ftn" } }
caret_footnote: { match: "^footnote(?())",    replace: { head: "@ftn" } }
