::kind(config)
::id(config-vault)
::macro(
  copyright:    "(C) 2026 Tomet Projects"
  generated_by: @comment[ Generated from $(1). Edit that, then `tomet export .`. ]
)
::format(
  meta: (always_newline: true)
  section: (
    space_inside_brackets: true
    blank_before: true
    blank_after: true
  )
  map: (
    align_values: true
    collapse_closing_parens: true
    multiline_comma: never
  )
  list:        (multiline.style.content: "box")
  code:        (fence.lines: "marked")
  declaration: (blank_after: true, blank_between: false)
  element: (
    table:   (adjust_width: auto, max_col_width: 50)
    link:    (no_space: true, group_order: "[]()")
    quote:   (always_newline: true)
    callout: (style: (content: block))
))
::field(
  aliases:    (type: list, always_newline: true)
  created:    (type: datetime, format: rfc3339, offset: "+09:00")
  modified:   (type: datetime, format: rfc3339, offset: "+09:00")
  topics:     (type: list, list_type: "@link", always_newline: false)
  url.wiki:   (type: list, always_newline: true)
  url.source: (type: list, always_newline: true)
  url.main:   (type: list, always_newline: true)
  lang:       (type: string)
  lang_name:  (type: string)
)
::vocabulary(
  @file(tmtroot/schema/writ@0.1.0.vocabulary.tmt)
  @file(tmtroot/schema/rust@0.1.0.vocabulary.tmt)
  @file(tmtroot/schema/bookmark.vocabulary.tmt)
  @file(tmtroot/schema/node-graph.vocabulary.tmt)
  @file(tmtroot/schema/scenario.vocabulary.tmt)
  @file(tmtroot/schema/video.vocabulary.tmt)
  @file(tmtroot/schema/idea.vocabulary.tmt)
  @file(tmtroot/schema/roots.vocabulary.tmt)
  @file(tmtroot/schema/catasto@0.1.0.vocabulary.tmt)
)
::dictionary(
  tomet: @file(tmtroot/dict/tomet.dict.tmt)
)
::blueprint(
  writ:    @file(tmtroot/schema/writ.blueprint.tmt)
  element: @file(tmtroot/schema/element.blueprint.tmt)
  crate:   @file(tmtroot/schema/crate.blueprint.tmt)
  demo:    @file(tmtroot/schema/demo.blueprint.tmt)
  catasto: @file(tmtroot/schema/catasto@0.1.0.blueprint.ctmt)
)
::workspace(
  ignore:  ("00-09 System/01 Apps/obsidian")
  unswept: ("tests/fixtures", "tests/ref", "tests/store")
)
